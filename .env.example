# ===== Triple Digital Workforce - Fruit Valley (Demo) =====

# --- Anthropic (חובה) ---
# מפתח API לפרסור ההזמנות עם Claude
ANTHROPIC_API_KEY=sk-ant-...
# מודל לטקסט חופשי ולצ'אט העובדים (ברירת מחדל: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5
# מודל לקריאת קבצים - PDF/סריקות/אקסל (ברירת מחדל: claude-opus-4-8)
ANTHROPIC_DOC_MODEL=claude-opus-4-8

# --- WhatsApp ---
# מספר איש הקשר שממנו מגיעות הזמנות (מנהלת המשרד / הלקוח)
SOURCE_CONTACT_NUMBER=0557118125

# שם קבוצת הוואטסאפ שאליה נשלח דף הליקוט (חובה - חייב להתאים בדיוק לשם הקבוצה)
PICKING_GROUP_NAME=הדפסות - דמו - טריפל
# שם קבוצת התמונות (אופציונלי - אם ריק, בקשת התמונות תישלח כתגובה בקבוצת הליקוט)
PHOTOS_GROUP_NAME=תמונות - דמו - טריפל
# OBSERVE_MODE=1  # מצב תצפית: אין שליחת הודעות פרטיות ללקוחות
#PHOTOS_GROUP_NAME_OLD=

# --- חברות ---
# הנציג מזמין עבור כמה חברות. ברירת המחדל בקוד (src/config.js):
# כרם קפיטל (KC) / טריפל (TR) / סולראדג' (SE). לשינוי בלי לגעת בקוד:
# COMPANIES=[{"name":"כרם קפיטל","nameEn":"Kerem Capital","initials":"KC","aliases":["כרם"]},{"name":"טריפל","nameEn":"Triple","initials":"TR","aliases":["triple"]}]

# --- לוגיקה עסקית ---
# שעת סגירת שינויים (מוצג בדף הליקוט ובאישור הקבלה)
CHANGES_CUTOFF=14:00

# --- מסך בקרה מקומי ---
# פורט של מסך הבקרה (סטטוס, QR, עצירה/הפעלה): http://localhost:<WEB_PORT>
WEB_PORT=3010

# --- CRM v2 (Google Sheets) ---
# מזהה הגיליון של ה-CRM (ברירת מחדל: הגיליון של פירות העמק)
CRM_SPREADSHEET_ID=1JRWKQblbuGn_4gLVFMl5rhgKCj5SIVI4vK9_kL2A8ag
# מפתח Google API (אופציונלי אך מומלץ - קריאה יציבה דרך Sheets API.
# בלעדיו: קריאה ציבורית לפי שם לשונית, מחייב שיתוף "כל מי שיש לו קישור - צפייה")
# GOOGLE_API_KEY=AIza...
# שמות הלשוניות (ברירת מחדל: אלו של פירות העמק)
# CRM_MAIN_SHEET=פירות העמק לקוחות
# CRM_INTERNAL_SHEET=פירות העמק פנימי
# תיקיית נתונים חלופית (לבדיקות בלבד)
# FV_DATA_DIR=

# --- ערוצי קלט נוספים ---
# תיקיית ההזמנות הקבועות בדרייב (תת-תיקייה פר לקוח, PDF פר יום)
FIXED_ORDERS_FOLDER_ID=1NBYb8PQIb2rG3U0kYO2u_kULc9F6ZnCk
# תיקיית גיליונות ההזמנה (תת-תיקייה פר לקוח עם גיליון שמתעדכן לפני כל הזמנה)
SHEETS_ORDERS_FOLDER_ID=1HPg7IsoKmmaOLi_2sjopzEiKfpxePWKn
# שעת ההנפקה האוטומטית של הזמנות קבועות (לפי הלוז של כל לקוח בנפרד)
FIXED_ISSUE_HOUR=06:30
# מייל (אפשר גם דרך מסך האונבורדינג): IMAP בקריאה בלבד
# EMAIL_USER=orders@business.co.il
# EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# EMAIL_HOST=imap.gmail.com
