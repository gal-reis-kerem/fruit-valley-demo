{
  "name": "fruit-valley-picking-demo",
  "version": "0.1.0",
  "description": "Triple Digital Workforce - Fruit Valley: WhatsApp order intake -> picking sheet PDF -> picking group -> photo request (demo)",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/index.js",
    "app": "electron .",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis",
    "test:pdf": "node scripts/test-pdf.js",
    "test:parse": "node scripts/test-parse.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "private": true,
  "build": {
    "appId": "co.il.triplep.fruitvalley",
    "productName": "Fruit Valley - Triple",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "src/**",
      "assets/**",
      "package.json"
    ],
    "asar": false,
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "dotenv": "^17.4.2",
    "puppeteer": "^25.3.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
